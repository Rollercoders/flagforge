PORT=6789
# Address to listen on (default: 127.0.0.1, this machine only; "localhost" means the same).
# Set to 0.0.0.0 to listen on all interfaces, or to a specific IP.
# HOST=localhost
STORAGE_TYPE=sqlite
STORAGE_PATH=./data/flagforge.db
# For JSON storage, use:
# STORAGE_TYPE=json
# STORAGE_PATH=./data/flags.json
# Admin password (auto-generated on first boot if not set)
# ADMIN_PASSWORD=
# Abilita il server MCP (agenti AI che gestiscono i flag). Lascia vuoto/rimuovi per tenerlo spento.
# MCP_TOKEN=
