{
  "name": "flagforge",
  "version": "0.1.0",
  "description": "Open-source, on-premise feature flagging platform",
  "type": "module",
  "main": "dist/index.js",
  "bin": "./dist/cli.js",
  "files": [
    "dist",
    "ui/dist",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    "ui"
  ],
  "scripts": {
    "dev": "concurrently \"tsx watch src/index.ts\" \"yarn ui:dev\"",
    "dev:server": "tsx watch src/index.ts",
    "build": "yarn ui:build && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "ui:dev": "yarn --cwd ui dev",
    "ui:build": "yarn --cwd ui build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "yarn build",
    "prepare": "husky"
  },
  "keywords": [
    "feature-flags",
    "feature-toggle",
    "rollout",
    "on-premise"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.6.0",
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "nanoid": "^5.0.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@eslint/js": "^9.39.2",
    "@types/better-sqlite3": "^7.6.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/eslint": "^9.6.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^1.1.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "supertest": "^6.3.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.53.0",
    "vitest": "^1.1.0"
  },
  "packageManager": "yarn@4.12.0"
}
